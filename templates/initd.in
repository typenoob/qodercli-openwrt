#!/bin/sh /etc/rc.common
# %%DISPLAY%% remote-control daemon.
#
# The daemon makes an outbound connection to the Qoder cloud and registers this
# machine as an environment; sessions are pushed down that connection, so
# nothing has to be port-forwarded and an SSH drop is irrelevant.
#
# `enable` alone only links the boot scripts; the instance is gated on the uci
# switch, and start_service says so on stderr when it is off:
#   %%BIN%% login                                    # or a PAT in token_file
#   uci set %%SRV%%.config.enabled=1 && uci commit %%SRV%%
#   /etc/init.d/%%SRV%% restart
#
# Reading the output: the CLI keeps its own structured run log, and that is where
# a registration actually shows up (`Remote-control event stream connected` plus
# the env_ id); the wrapper's and the payload's own stream is forwarded by procd
# to the system log, because stdout/stderr are enabled below.
#   ls -l /root/.qoder*/logs/latest
#   logread | grep %%SRV%%
#
# Start it only after the payload is installed and the account is logged in,
# otherwise it respawn-loops on an authentication error:
#   %%BIN%% --version            # payload present and runnable
#   %%BIN%% login                # or point token_file at a PAT

START=99
STOP=10
USE_PROCD=1

PKG=%%PKG%%
SRV=%%SRV%%
WRAPPER=/usr/libexec/$PKG/run-daemon.sh

cfg() {
    v=""
    if command -v uci >/dev/null 2>&1; then
        v=$(uci -q get "$SRV.config.$1" 2>/dev/null)
    fi
    [ -n "$v" ] || v="$2"
    printf '%s' "$v"
}

start_service() {
    if [ "$(cfg enabled 0)" != "1" ]; then
        # `enable` alone only links the boot scripts, so a start that stays quiet
        # here reads as "active with no instances" with nothing to point at it.
        echo "$SRV: $SRV.config.enabled is not 1, no instance started" >&2
        echo "$SRV: after logging in run: uci set $SRV.config.enabled=1 && uci commit $SRV" >&2
        return 0
    fi

    if [ ! -x "$WRAPPER" ]; then
        echo "$SRV: $WRAPPER missing" >&2
        return 1
    fi

    threshold=$(cfg respawn_threshold 3600)
    timeout=$(cfg respawn_timeout 5)
    retry=$(cfg respawn_retry 5)

    procd_open_instance "$SRV"
    procd_set_param command /bin/sh "$WRAPPER"
    procd_set_param respawn "$threshold" "$timeout" "$retry"
    # booleans, not paths: a file name here does not make procd write a log.
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 15
    procd_set_param limits core="unlimited"
    procd_set_param file /etc/config/$SRV
    procd_set_param pidfile /var/run/$SRV.pid
    procd_close_instance
}

service_stopped() {
    :
}

reload_service() {
    stop
    start
}
